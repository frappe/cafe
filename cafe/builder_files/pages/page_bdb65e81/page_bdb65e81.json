 "page_data_script": "if frappe.session.user == \"Guest\":\n    raise redirect(\"/login\")\n\nuser = frappe.db.get_value(\n    \"Cafe User\",\n    {\"handle\": frappe.form_dict.handle},\n    [\"handle\", \"company\", \"designation\", \"bio\", \"introduction\", \"user\"],\n    as_dict=1,\n)\n\nif not user:\n    raise frappe.PageDoesNotExistError\n\nif frappe.session.user != user.user:\n    raise redirect(\"/cafe/explore\")\n\nfrappe_user = frappe.db.get_value(\"User\", user.user, [\"full_name\", \"email\"], as_dict=1)\n\nbreadcrumbs = [\n    {\"label\": \"Café\", \"url\": \"/cafe/explore\"},\n    {\"label\": frappe_user.full_name, \"url\": f\"/cafe/profile/{user.handle}\"},\n    {\"label\": \"Settings\", \"url\": \"#\"},\n]\n\ndata.page_data = {\n    \"is_logged_in\": frappe.session.user != \"Guest\",\n    \"breadcrumbs\": breadcrumbs,\n    \"user\": {**user, **frappe_user},\n}\n",
