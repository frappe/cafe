 "page_data_script": "if not frappe.session.user:\n    redirect(\"/login\")\n\nif not frappe.db.exists(\"Cafe User\", frappe.session.user):\n    redirect(\"/cafe/onboarding\")\n\ndata.tags = frappe.get_all(\"Cafe Post Tag\", fields=[\"name\"], filters={\"is_standard\": 1})\n\n\nbreadcrumbs = [\n    {\"label\": \"Café\", \"url\": \"/cafe/explore\"},\n    {\"label\": \"Edit Post\", \"url\": \"#\"},\n]\n\ndata.page_data = {\n    \"is_logged_in\": frappe.session.user != \"Guest\",\n    \"tags\": data.tags,\n    \"breadcrumbs\": breadcrumbs,\n}\n",
