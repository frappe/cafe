 "head_html": "<style>\n  textarea {\n    box-shadow: none !important;\n    transition: none !important;\n  }\n\n  input {\n    box-shadow: none !important;\n    transition: none !important;\n  }\n\n\n  #tags-container {\n    position: relative;\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 6px;\n    padding: 6px 0;\n  }\n\n  .tag-chip {\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n    padding: 2px 8px;\n    border-radius: 9999px;\n    font-size: 13px;\n    background-color: var(--ink-gray-1);\n    color: var(--ink-gray-7);\n    border: 1px solid var(--ink-gray-1);\n    user-select: none;\n  }\n\n  .tag-chip .tag-remove {\n    font-size: 15px;\n    line-height: 1;\n    cursor: pointer;\n    opacity: 0.7;\n    margin-left: 2px;\n  }\n\n  .tag-chip .tag-remove:hover {\n    opacity: 1;\n  }\n\n  .tag-input-wrapper {\n    position: relative;\n    display: inline-flex;\n    flex: 1;\n    min-width: 120px;\n  }\n\n  .tag-search-input {\n    border: none;\n    outline: none;\n    font-size: 14px;\n    color: #334155;\n    background: transparent;\n    width: 100%;\n  }\n\n\n  .tag-dropdown {\n    position: absolute;\n    top: 100%;\n    left: 0;\n    z-index: 99999;\n    background: #ffffff;\n    border: 1px solid rgba(0, 0, 0, 0.08);\n    border-radius: 10px;\n    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.15);\n    max-height: 220px;\n    overflow-y: auto;\n    padding: 4px;\n    display: none;\n  }\n\n  .tag-dropdown.is-open {\n    display: block;\n  }\n\n  .tag-option {\n    padding: 6px;\n    border-radius: 6px;\n    font-size: 13px;\n    color: var(--ink-gray-7);\n    cursor: pointer;\n  }\n\n  .tag-option:hover {\n    background-color: #f3f4f6;\n  }\n\n  .tag-option.no-results {\n    color: #94a3b8;\n    cursor: default;\n  }\n\n  .tag-option.no-results:hover {\n    background: none;\n  }\n\n\n  #editor-toolbar {\n    display: inline-flex;\n    padding: 10px;\n    color: #334155;\n    position: sticky;\n    top: var(--navbar-height, 50px);\n    z-index: 999;\n    background-color: #ffffff;\n    width: 100%;\n    max-width: 800px;\n    box-sizing: border-box;\n    overflow-x: auto;\n    scrollbar-width: none;\n    padding-left: 18px;\n    padding-right: 18px;\n    flex-shrink: 0;\n    min-height: 50px;\n  }\n\n  @media (min-width: 790px) {\n    #editor-toolbar {\n      justify-content: center;\n    }\n  }\n\n  #editor-toolbar::-webkit-scrollbar {\n    display: none;\n  }\n\n  #editor-toolbar .tb-group {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    flex-wrap: nowrap;\n  }\n\n  #editor-toolbar .tb-btn {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border-radius: 4px;\n    padding: 4px;\n    color: #334155;\n    transition: background-color 150ms ease, color 150ms ease;\n    background-color: transparent;\n    border: none;\n    cursor: pointer;\n    font-size: 14px;\n    min-width: 26px;\n  }\n\n  #editor-toolbar .tb-btn:hover {\n    background-color: #F3F3F3;\n  }\n\n  #editor-toolbar .tb-btn.is-active {\n    background-color: var(--ink-gray-1);\n  }\n\n  #editor-toolbar .tb-icon {\n    height: 16px;\n    width: 16px;\n  }\n\n  #editor-toolbar .tb-text {\n    display: inline-block;\n    height: 16px;\n    min-width: 16px;\n    font-size: 14px;\n    line-height: 16px;\n    font-weight: 600;\n    text-align: center;\n    font-family: inherit;\n  }\n\n  #editor-toolbar .tb-separator {\n    height: 16px;\n    width: 1px;\n    background-color: #e2e8f0;\n    margin: 0 2px;\n  }\n\n  #editor-toolbar .tb-dropdown-container {\n    position: relative;\n    display: inline-block;\n  }\n\n  #editor-toolbar .tb-dropdown-menu {\n    position: absolute;\n    top: 100%;\n    left: 0;\n    z-index: 10;\n    background-color: #ffffff;\n    border: 1px solid rgba(0, 0, 0, 0.05);\n    border-radius: 12px;\n    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);\n    padding: 6px;\n    margin-top: 8px;\n    display: none;\n    flex-direction: column;\n    gap: 2px;\n  }\n\n  #editor-toolbar .tb-dropdown-menu:focus {\n    outline: none;\n  }\n\n  #editor-toolbar .tb-dropdown-menu.is-open {\n    display: flex;\n  }\n\n  #editor-toolbar .tb-menu-item {\n    width: 100%;\n    min-width: max-content;\n    justify-content: flex-start;\n  }\n\n  #editor img[data-loading=\"true\"],\n  #editor video[data-loading=\"true\"] {\n    opacity: 0.5;\n    animation: upload-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n  }\n\n  @keyframes upload-pulse {\n\n    0%,\n    100% {\n      opacity: 0.5;\n    }\n\n    50% {\n      opacity: 0.85;\n    }\n  }\n\n  #editor video {\n    max-width: 100%;\n    border-radius: 4px;\n  }\n\n  #editor video[data-error] {\n    border: 2px solid #ef4444;\n    cursor: pointer;\n  }\n\n  #cover-image-picker {\n    width: 100%;\n    position: relative;\n    margin-bottom: 32px;\n  }\n\n  #cover-image-drop-zone {\n    width: 100%;\n    height: 120px;\n    border: 2px dashed #d1d5db;\n    border-radius: 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    background: #f9fafb;\n    transition: border-color 0.2s, background 0.2s;\n    box-sizing: border-box;\n    overflow: hidden;\n  }\n\n  #cover-image-drop-zone:hover,\n  #cover-image-drop-zone.drag-over {\n    border-color: #6b7280;\n    background: #f3f4f6;\n  }\n\n  #cover-image-drop-zone.has-image {\n    border: none;\n    background: transparent;\n    height: auto;\n  }\n\n  #cover-image-placeholder {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 8px;\n    color: #9ca3af;\n    pointer-events: none;\n  }\n\n  #cover-image-placeholder svg {\n    width: 20px;\n    stroke: #9ca3af;\n  }\n\n  #cover-image-placeholder span {\n    font-size: 13px;\n  }\n\n  #cover-image-preview {\n    display: none;\n    width: 100%;\n    aspect-ratio: 16 / 9;\n    object-fit: cover;\n    border-radius: 12px;\n  }\n\n  #cover-image-drop-zone.has-image #cover-image-preview {\n    display: block;\n  }\n\n  #cover-image-drop-zone.has-image #cover-image-placeholder {\n    display: none;\n  }\n\n  #cover-image-actions {\n    display: none;\n    position: absolute;\n    top: 10px;\n    right: 10px;\n    gap: 6px;\n  }\n\n  #cover-image-drop-zone.has-image~#cover-image-actions {\n    display: flex;\n  }\n\n  .cover-image-action-btn {\n    background: rgba(0, 0, 0, 0.55);\n    color: #fff;\n    border: none;\n    border-radius: 6px;\n    padding: 4px 10px;\n    font-size: 12px;\n    cursor: pointer;\n    backdrop-filter: blur(4px);\n  }\n\n  .cover-image-action-btn:hover {\n    background: rgba(0, 0, 0, 0.75);\n  }\n\n  #cover-image-input {\n    display: none;\n  }\n</style>",
