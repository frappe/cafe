 "page_data_script": "user = frappe.db.get_value(\n    \"Cafe User\",\n    {\"handle\": frappe.form_dict.handle},\n    [\"handle\", \"user\"],\n    as_dict=1,\n)\n\nif user.user != frappe.session.user:\n    raise frappe.PermissionError(\"You don't have permission to view this page\")\n\nUserBookmark = frappe.qb.DocType(\"Cafe Post Bookmark\")\nPost = frappe.qb.DocType(\"Cafe Post\")\nCafeUser = frappe.qb.DocType(\"Cafe User\")\n\nquery = (\n    frappe.qb.from_(UserBookmark)\n    .inner_join(Post)\n    .on(UserBookmark.post == Post.name)\n    .select(\n        Post.name,\n        Post.title,\n        Post.description,\n        Post.cover_image,\n        Post.reading_time,\n        Post.slug,\n        Post.creation,\n    )\n    .where(UserBookmark.owner == frappe.session.user)\n)\n\ndata.posts = query.run(as_dict=True)\n",
